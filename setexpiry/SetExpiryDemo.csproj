<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SetExpiryDemo</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <!-- the SEXPIRE family has no client API yet, so SetExpiry.cs drives it entirely through the
         v4 context surface; v4 is in alpha -->
    <PackageReference Include="StackExchange.Redis" VersionOverride="$(SERedisV4Version)" />
  </ItemGroup>

</Project>
