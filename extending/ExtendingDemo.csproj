<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExtendingDemo</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- the context surface (db.Context, SendAsync, Compose, [Resp]) is a v4 feature; v4 is in alpha -->
    <PackageReference Include="StackExchange.Redis" Version="4.0.155-alpha" />
  </ItemGroup>

</Project>
