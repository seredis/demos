<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CachingDemo</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <!-- client-side caching is a v4 feature; v4 is in alpha; the version is SERedisV4Version in Directory.Packages.props -->
    <PackageReference Include="StackExchange.Redis" VersionOverride="$(SERedisV4Version)" />
  </ItemGroup>

</Project>
